# Copy to .env and fill in. Never commit .env.

# SEC requires a descriptive User-Agent with contact email
SEC_USER_AGENT="IPO-watch your-name your-email@example.com"

DATABASE_URL=sqlite:///data/ipo_watch.sqlite

# Optional APIs (leave blank to disable the collector)
ANTHROPIC_API_KEY=
FRED_API_KEY=
KALSHI_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Alerts
ALERT_CHANNEL=          # email | discord | telegram
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
